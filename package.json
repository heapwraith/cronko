{
  "name": "cronko",
  "private": true,
  "version": "0.3.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "db:generate": "cd packages/database && drizzle-kit generate",
    "db:migrate": "cd packages/database && drizzle-kit migrate",
    "db:studio": "cd packages/database && drizzle-kit studio",
    "prepare": "lefthook install",
    "audit": "pnpm audit --audit-level high",
    "sbom": "cyclonedx-npm --output-file sbom.json",
    "format": "biome check --write .",
    "e2e": "playwright test"
  },
  "pnpm": {
    "allowedDeprecatedVersions": {
      "@esbuild-kit/core-utils": "*",
      "@esbuild-kit/esm-loader": "*",
      "prebuild-install": "*"
    },
    "overrides": {
      "vite": ">=8.1.6",
      "minimatch@>=7 <11": "^11.0.1",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "^5.1.0",
    "lefthook": "^2.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
