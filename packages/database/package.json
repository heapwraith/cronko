{
  "name": "@cronko/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./queries/monitors": "./src/queries/monitors.ts",
    "./queries/heartbeats": "./src/queries/heartbeats.ts",
    "./queries/incidents": "./src/queries/incidents.ts",
    "./queries/notifications": "./src/queries/notifications.ts",
    "./queries/settings": "./src/queries/settings.ts",
    "./queries/users": "./src/queries/users.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@cronko/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3"
  }
}
