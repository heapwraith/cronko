# Cronko environment variables
# Copy to .env and fill in the required values.

# Database (required) — SQLite only
DATABASE_URL=file:./data/cronko.db

# API
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# Behind a reverse proxy: trust X-Forwarded-* and allow your public origin
# TRUST_PROXY=true
# TRUSTED_ORIGINS=https://cronko.example.com

# Security (required in production — generate with: openssl rand -base64 32)
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Monitor the monitor (optional): ping this URL every N seconds while Cronko is healthy
# (database up, scheduler ticking). Point it at another Cronko or Healthchecks.io.
SELF_HEARTBEAT_URL=
SELF_HEARTBEAT_INTERVAL_SECONDS=300

# Public address of this Cronko; alerts link straight to the failing run
PUBLIC_URL=

# Notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=

# Logging (development | production | test)
# LOG_LEVEL=info

