# Cronko environment variables
# Copy to .env and fill in the required values.

# Database (required) — SQLite only
DATABASE_URL=file:./data/cronko.db

# API
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# Behind a reverse proxy: trust X-Forwarded-* and allow your public origin
# TRUST_PROXY=true
# TRUSTED_ORIGINS=https://cronko.example.com

# Security (required in production — generate with: openssl rand -base64 32)
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Monitor the monitor (optional): ping this URL every N seconds while Cronko is healthy
# (database up, scheduler ticking). Point it at another Cronko or Healthchecks.io.
SELF_HEARTBEAT_URL=
SELF_HEARTBEAT_INTERVAL_SECONDS=300

# Public address of this Cronko; alerts link straight to the failing run
PUBLIC_URL=

# Notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Discord, Telegram, Slack and the other channels are configured in the UI.

# Ping by e-mail (optional). Mail to <token>@INBOUND_EMAIL_DOMAIN becomes a ping.
# Point the domain's MX record at this host and expose the port (25 publicly).
# INBOUND_SMTP_PORT=2525
# INBOUND_EMAIL_DOMAIN=ping.example.com
# Optional PEM files to offer STARTTLS:
# INBOUND_SMTP_TLS_CERT=
# INBOUND_SMTP_TLS_KEY=

# Logs are debug in development and info in production (NODE_ENV above).

